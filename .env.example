# ==========================================
# DATABASE SETTINGS (e.g. from Aiven MySQL)
# ==========================================
# Note: For Aiven, make sure your URL looks like: jdbc:mysql://YOUR_AIVEN_HOST:PORT/defaultdb?useSSL=true&requireSSL=true
DB_URL=jdbc:mysql://mysql-something.aivencloud.com:26453/defaultdb?useSSL=true&requireSSL=true
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password

# ==========================================
# JWT SECURITY SETTINGS
# ==========================================
# Replace with any strong random string for production
JWT_SECRET=SuperSecretProductionKeyThatIsAtLeast32CharsLong123!

# ==========================================
# EMAIL SETTINGS (For OTP and notifications)
# ==========================================
# Use your Gmail address and 16-character App Password (No spaces)
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# ==========================================
# SERVER SETTINGS
# ==========================================
# Hosting providers like Render/Railway usually set this automatically, 
# but you can explicitly specify it if needed.
PORT=8080
